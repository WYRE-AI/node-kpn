{
  "name": "@wyre-technology/node-kpn",
  "version": "0.0.0-development",
  "description": "Node.js client library for the KPN API Store (Disturbance Check, Internet Speed Check, SIM Swap, Mobile Services Management)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prebuild": "npm run clean",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyre-technology/node-kpn.git"
  },
  "keywords": [
    "kpn",
    "kpn-zakelijk",
    "mobile-services-management",
    "sim-swap",
    "disturbance-check",
    "msp",
    "api-client"
  ],
  "author": "WYRE Technology",
  "license": "Apache-2.0",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@types/node": "^26.0.1",
    "msw": "^2.4.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
