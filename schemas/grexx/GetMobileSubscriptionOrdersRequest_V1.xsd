<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="GetMobileSubscriptionOrdersRequest_V1" nillable="false" type="GetMobileSubscriptionOrdersRequest_V1" />
  <xs:complexType name="GetMobileSubscriptionOrdersRequest_V1">
    <xs:annotation>
      <xs:documentation>Met een GetMobileSubscriptionOrdersRequest kan de order informatie van een of meer mobiele orders opgevraagd worden</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="OrderIds" type="ArrayOfInt">
        <xs:annotation>
          <xs:documentation>Lijst van IRMA Order IDs van de mobiele orders</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ArrayOfInt">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="50" name="OrderId" type="xs:int">
        <xs:annotation>
          <xs:documentation>IRMA Order ID van de mobiele order</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
