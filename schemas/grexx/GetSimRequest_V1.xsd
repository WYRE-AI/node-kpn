<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="GetSimRequest_V1" nillable="false" type="GetSimRequest_V1" />
  <xs:complexType name="GetSimRequest_V1">
    <xs:annotation>
      <xs:documentation>Met een GetSimRequest kan de (actieve) simkaart uit de (actieve) mobiele order opgevraagd worden</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="OrderId" type="xs:int">
        <xs:annotation>
          <xs:documentation>IRMA Order ID van de mobiele order</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
